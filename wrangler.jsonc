{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jev-triage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["TRIAGE_TOKEN"]
  }
}
